# Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# Do NOT commit .env with real secrets to version control!

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Firebase Common Project Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_STORAGE_BUCKET=your_storage_bucket_url

# Firebase Web Platform Configuration
FIREBASE_WEB_API_KEY=your_web_api_key
FIREBASE_WEB_APP_ID=your_web_app_id
FIREBASE_WEB_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_WEB_MEASUREMENT_ID=your_measurement_id

# Firebase Android Platform Configuration
FIREBASE_ANDROID_API_KEY=your_android_api_key
FIREBASE_ANDROID_APP_ID=your_android_app_id

# Firebase iOS / macOS Platform Configuration
FIREBASE_IOS_API_KEY=your_ios_api_key
FIREBASE_IOS_APP_ID=your_ios_app_id
FIREBASE_IOS_BUNDLE_ID=com.neonecy.necteam
FIREBASE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com
FIREBASE_IOS_ANDROID_CLIENT_ID=your_ios_android_client_id.apps.googleusercontent.com
